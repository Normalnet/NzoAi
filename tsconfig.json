{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@nzoai/store": ["./packages/store/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["api/**/*", "apps/web/src/**/*", "apps/web/auth.ts"]
}
