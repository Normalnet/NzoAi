{
  "name": "nzoai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @nzoai/web dev",
    "dev:server": "pnpm --filter @nzoai/server dev",
    "build": "pnpm -r run build",
    "check-types": "pnpm -r exec tsc --noEmit",
    "clean": "pnpm -r exec rm -rf node_modules dist .output"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.16",
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@neon/realtime": "^0.1.2",
    "better-auth": "^1.1.21",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3"
  }
}
