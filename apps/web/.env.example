# ==============================================================================
# NZOAI WEB APPLICATION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Database Connection (PostgreSQL with pgvector enabled)
# For Neon: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nzoai
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/nzoai

# 2. Authentication (Better Auth)
# Generate a 32+ character random secret: openssl rand -hex 32
BETTER_AUTH_SECRET=a_very_secret_key_minimum_32_characters_long_12345
BETTER_AUTH_URL=http://localhost:3001
VITE_BETTER_AUTH_URL=http://localhost:3001

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 3. AI & Embeddings (OpenAI)
# Requires an active billing account with credits at platform.openai.com
# Used for gpt-4o-mini (chat & tool calls) and text-embedding-3-small (768-dim knowledge search)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Payment Gateway (Paystack Ghana - Cards & Mobile Money: MTN, Telecel, AT)
# Get test/live keys from: https://dashboard.paystack.co/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. In-Memory Cache & Rate Limiting (Redis)
# Can be local Redis (redis://localhost:6379) or serverless Upstash (rediss://...)
REDIS_URL=redis://localhost:6379

# 6. Email Service (Resend - for team invitations and human escalation alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ALERTS=NzoAI Support <alerts@yourdomain.com>
EMAIL_FROM_INVITES=NzoAI Team <invites@yourdomain.com>

# 7. Web Crawler & Single-Page Scraper (Firecrawl - Optional)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_BASE_URL=http://localhost:3001

# 8. Document Storage (Option 2 - Direct PostgreSQL Ingestion)
# No external AWS S3 or Cloudflare R2 bucket required! Extracted text is stored in Postgres.

# 9. Superadmin Access (Comma-separated list of founder / platform admin emails)
SUPERADMIN_EMAILS=admin@nzoai.com,founder@nzoai.com

# 10. WebSocket Server (Realtime Human Escalation Server)
SERVER_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
NODE_ENV=development
