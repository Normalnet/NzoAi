# ==============================================================================
# NZOAI REALTIME WEBSOCKET SERVER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Database Connection (Same database as apps/web)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nzoai
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/nzoai

# Server Port (Runs on 3000 to avoid conflicting with apps/web on 3001)
PORT=3000

# CORS Allowed Origins (* in development, or https://your-domain.vercel.app in production)
CORS_ORIGIN=*
